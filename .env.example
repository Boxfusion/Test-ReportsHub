# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# Active environment; playwright.config.ts resolves baseURL from <TEST_ENV>_APP_URL
TEST_ENV=dev

# --- Environments (site URLs) ---
DEV_APP_URL=
QA_APP_URL=
TEST_APP_URL=

# --- Roles: one <ROLE>_USERNAME / <ROLE>_PASSWORD pair per login role ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Relationship Manager — required by the Land Bank CRM lead-capture plans
# (see projects/land-bank/CLAUDE.md → Credentials)
RM_USERNAME=
RM_PASSWORD=
